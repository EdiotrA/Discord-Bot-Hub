modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Loopy Bot"

[[workflows.workflow]]
name = "Loopy Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Loopy-Command-Hub && pnpm --filter @workspace/loopy-bot run start"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
OAUTH_REDIRECT_URI = "https://25e13a02-b550-4be3-9581-81b5e8d853d8-00-5uu3txdmhig6.picard.replit.dev/api/oauth/discord/callback"
